function scr_Stat_Up_Choose(_classform) {
	switch (_classform) {
    	case "Strength Field": return "A00"
        case "Vitality Field": return "B00"
        case "Essence Field": return "C00"
        case "Dexterity Field": return "D00"
        case "Perception Field": return "E00"
        case "State Field": return "F00"
    }
}
