function scr_Pause_Main_Leave() {
	with (obj_Pause) {
	    instance_destroy();
	}
	with (obj_Soul_Menu_Butt) {
	    instance_destroy();
	}
	with (obj_State_Menu) {
	    instance_destroy();
	}
	with (obj_Recollection_Menu_Butt) {
	    instance_destroy();
	}
	with (obj_Settings_Menu_Butt) {
	    instance_destroy();
	}
	with (obj_Save_Quit) {
	    instance_destroy();
	}
	with (obj_Pause_Parent) {
	    instance_destroy();
	}
	with (obj_Dream_Cursor) {
	    instance_destroy();
	}
	with (obj_Option_Reset) {
	    instance_destroy();
	}
	with (obj_Recollection_Scroll_Bar) {
	    instance_destroy();
	}



}
