function scr_Recollect_Item_Store() {
	//within the Item Status Store

	//recollection[0,0] = 0;

	for(i = 1; i <= 999; i++) {
	    global.recollectionWeap[i] = 0;
	}
	global.recollectionWeap[1] = 2;

	for(i = 1; i <= 999; i++) {
	    global.recollectionFloorWeap[i] = 0;
	}

	for(i = 1; i <= 200; i++) {
	    global.recollectionBoss[i] = 0;
	}
	
	for(i = 1; i <= 20; i++) {
	    global.recollectionState[i] = 0;
	}
	global.recollectionStateUnlocked = 0;
	
	for(i = 1; i <= 49; i++) {
	    global.recollectionA[i] = 0;
	    global.recollectionB[i] = 0;
	    global.recollectionC[i] = 0;
	    global.recollectionD[i] = 0;
	    global.recollectionE[i] = 0;
	    global.recollectionF[i] = 0;
	    global.recollectionG[i] = 0;
	    global.recollectionH[i] = 0;
	    global.recollectionI[i] = 0;
	    global.recollectionJ[i] = 0;
	    global.recollectionK[i] = 0;
	    global.recollectionL[i] = 0;
	    global.recollectionM[i] = 0;
	    global.recollectionN[i] = 0;
	    global.recollectionOA[i] = 0;
		global.recollectionOB[i] = 0;
		global.recollectionOC[i] = 0;
	    global.recollectionP[i] = 0;
	    global.recollectionQ[i] = 0;
	    global.recollectionR[i] = 0;
	    global.recollectionS[i] = 0;
	    global.recollectionT[i] = 0;
	    global.recollectionU[i] = 0;
	    global.recollectionV[i] = 0;
	    global.recollectionW[i] = 0;
		global.recollectionXA[i] = 0;
		global.recollectionXB[i] = 0;
		global.recollectionXC[i] = 0;
	}



}
