/// @function scr_Get_Boss_Object(boss_type)
/// @description Returns the boss object for a BOSS_TYPE value, or noone if unknown.
function scr_Get_Boss_Object(_bosstype) {
    switch (_bosstype) {
        case BOSS_TYPE.WALL_WATCHER: return obj_wall_watcher_v2;
        case BOSS_TYPE.DEEP_WATCHER: return obj_deep_watcher_v2;
        case BOSS_TYPE.GROWING_SORROWS: return obj_growing_sorrows_v2;
        case BOSS_TYPE.SOARING_SORROWS: return obj_soaring_sorrows_v2;
        case BOSS_TYPE.THOUGH_CLOUD: return obj_thought_cloud_v2;
        case BOSS_TYPE.INFATUATION_CLOUD: return obj_infatuation_cloud_v2;
        case BOSS_TYPE.WALL_OF_THOUGHTS: return obj_wall_of_thoughts_v2;
        case BOSS_TYPE.DARK_STORM_CLOUD: return obj_dark_storm_cloud;
        case BOSS_TYPE.AMORPHOUS_JELLO: return obj_amorphous_jello;
        case BOSS_TYPE.ANGRY_AMORPHOUS: return obj_Agony_Amorphous;
        case BOSS_TYPE.AMORPHOUS_PRIME: return obj_Amorphous_Prime;
        case BOSS_TYPE.HAND_OF_THE_ACCUSOR: return obj_hand_of_the_accusor_v2;
        case BOSS_TYPE.CURSED_CLAPPER: return obj_cursed_clapper_v2;
        case BOSS_TYPE.FRIGHTFUL_SPIRIT: return obj_frightful_spirit_v2;
        case BOSS_TYPE.WICKED_SPECTRE: return obj_Wicked_Spectre;
        case BOSS_TYPE.HORROR_STACK: return obj_horror_stack_v2;
        case BOSS_TYPE.TWISTER_DEMON: return obj_Twister_Demon;
        case BOSS_TYPE.FIRE_STARTER: return obj_fire_starter_v2;
        case BOSS_TYPE.WHACK_A_SOUL: return obj_whack_a_soul;
        case BOSS_TYPE.SPIRE: return obj_spire_v2;
        case BOSS_TYPE.BLIND_HUNGER: return obj_Blind_Hunger;
        case BOSS_TYPE.GUARDIAN_OF_KNOWING: return obj_Guardian_of_Knowing;
        case BOSS_TYPE.HEART_ACHE: return obj_heart_ache_v2;
        case BOSS_TYPE.NINJA_SPIRIT: return obj_ninja_spirit_v2;
        case BOSS_TYPE.WISPER: return obj_wisper_v2;
        case BOSS_TYPE.MANIC_WALL_MAGE: return obj_Manic_Wall_Mage;
        case BOSS_TYPE.CRAZY_EYE: return obj_Crazy_Eye;
        case BOSS_TYPE.PHASE_CRAWLER: return obj_Phase_Crawler;
        case BOSS_TYPE.BARRIER_DEMON: return obj_Barrier_Demon;
        case BOSS_TYPE.BEHEMOTH: return obj_Behemoth;
        case BOSS_TYPE.SLEEPER: return obj_Sleeper;
        case BOSS_TYPE.BRAIN_DEAD: return obj_brain_dead;
        case BOSS_TYPE.RESTLESS: return obj_restless;
        case BOSS_TYPE.LOCUST: return obj_Locust;
        case BOSS_TYPE.GRIM_APPARITION: return obj_grim_apparition_v2;
        case BOSS_TYPE.DREAM_INVADER: return obj_Dream_Invader;
        case BOSS_TYPE.POGO_PAL: return obj_pogo_pal_v2;
        case BOSS_TYPE.CRUSH: return obj_Crush;
        case BOSS_TYPE.MIGRAINE: return obj_Migraine;
        case BOSS_TYPE.VILLAIN: return obj_Villain;
        case BOSS_TYPE.THE_VEIL: return obj_The_Veil;
        case BOSS_TYPE.POCKET: return obj_pocket_v2;
        case BOSS_TYPE.GUTTER_BALL: return obj_gutter_ball_v2;
        case BOSS_TYPE.CONGA_LINE: return obj_conga_line_v2;
        case BOSS_TYPE.TOUGH_LUCK: return obj_Tough_Luck;
        case BOSS_TYPE.SOUL_COLLECTOR: return obj_Soul_Collector;
        case BOSS_TYPE.FLEEING_TWIN_HORROR: return obj_Fleeing_Twin_Horror;
        case BOSS_TYPE.SCARECROW: return obj_scarecrow;
        case BOSS_TYPE.MIND_CORRUPTOR: return obj_Mind_Corruptor;
        case BOSS_TYPE.THE_HOST: return obj_the_host;
        case BOSS_TYPE.DREAM_CRALWER: return obj_Dream_Crawler;
        case BOSS_TYPE.BOXER: return obj_boxer;
        case BOSS_TYPE.SLEEP_WALKER: return obj_sleep_walker;
        case BOSS_TYPE.WISP_HEART: return obj_will_wisp_heart;
        case BOSS_TYPE.WALL_KING: return obj_wall_king;
        case BOSS_TYPE.RED_BOSS_BEAD: return obj_red_boss_bead;
        case BOSS_TYPE.PUCK: return obj_Puck;
        case BOSS_TYPE.PUCK_MASS: return obj_Puck_Mass;
        case BOSS_TYPE.TOUCH_GHOUL: return obj_touch_ghoul;
        case BOSS_TYPE.SMELL_GHOUL: return obj_smell_ghoul;
        case BOSS_TYPE.TASTE_GHOUL: return obj_taste_ghoul;
        case BOSS_TYPE.HEAR_GHOUL: return obj_hear_ghoul;
        case BOSS_TYPE.SIGHT_GHOUL: return obj_sight_ghoul;
        case BOSS_TYPE.SNAKE_EYES: return obj_Snake_Eyes;
        case BOSS_TYPE.KING_OF_BEASTS: return obj_King_Of_Beasts;
        case BOSS_TYPE.THE_CONSTRUCT: return obj_The_Construct;
        case BOSS_TYPE.BRAINWASH: return obj_Brainwash;
        case BOSS_TYPE.BED_BUG: return obj_Bed_Bug;
        case BOSS_TYPE.DUNGEON_MASTER: return obj_Dungeon_Master;
        case BOSS_TYPE.SLEEP_CASTER: return obj_Sleep_Caster;
        case BOSS_TYPE.HEAD_IN_THE_CLOUDS: return obj_Head_In_The_Clouds;
        case BOSS_TYPE.SPIRIT_OF_MISCHIEF: return obj_spirit_of_mischief_v2;
        case BOSS_TYPE.FLASH_KNIGHT: return obj_Flash_Knight;
        case BOSS_TYPE.SANDMAN: return obj_Sandman;
        case BOSS_TYPE.DREAMER_X_NIGHTMARE: return obj_Nightmare;
        case BOSS_TYPE.MASKED_HOPE_SPIRIT: return obj_Masked_Hope_Spirit;
        case BOSS_TYPE.MASKED_BLISS_SPIRIT: return obj_Masked_Bliss_Spirit;
        case BOSS_TYPE.MASKED_VANITY_SPIRIT: return obj_Masked_Vanity_Spirit;
        case BOSS_TYPE.MASKED_LOATHING_SPIRIT: return obj_Masked_Loathing_Spirit;
        case BOSS_TYPE.MASKED_PARANOIA_SPIRIT: return obj_Masked_Paranoia_Spirit;
        case BOSS_TYPE.MASKED_DESPAIR_SPIRIT: return obj_Masked_Despair_Spirit;
    }
    return noone;
}
