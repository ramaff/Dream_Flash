if bullet_stats.bullet_fade = 1 {
	if alarm[0] < 15 {
		bullet_stats.bullet_power = 0;
		image_xscale -= image_xscale / alarm[0]
		image_yscale -= image_yscale / alarm[0]
	}
}


if bullet_stats.bullet_direction_angle = 1 {
	image_angle = direction;
}




