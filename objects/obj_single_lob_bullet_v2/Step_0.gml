if bullet_stats.bullet_bounce_gravity != 0 {
	if scr_bullet_lob(bullet_stats) {
		bullet_stats.bullet_bounce_height = 0;	
		bullet_stats.bullet_bounce_speed = 0;	
		bullet_stats.bullet_bounce_gravity = 0;
		
		bullet_stats.bullet_speed = 0;
		speed = bullet_stats.bullet_speed
	}
}
