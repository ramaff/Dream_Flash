with (other) {
    if other.PositiveType = 1 {
        global.soulstrengthTemp += 2;
    }
    if other.PositiveType = 2 {
        global.soulvitalityTemp += 2;
    }
    if other.PositiveType = 3 {
        global.soulessenceTemp += 2;
    }
    if other.PositiveType = 4 {
        global.souldexterityTemp += 2;
    }
    if other.PositiveType = 5 {
        global.soulperceptionTemp += 2;
    }
    if other.PositiveType = 6 {
        global.soulstateTemp += 2;
    }
}
instance_destroy();

